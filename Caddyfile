# (опционально) укажи почту для ZeroSSL/LE
{
  email admin@26studio.ru
}

# Боевой виртуальный хост для домена
26studio.ru, www.26studio.ru {
  encode zstd gzip

  @api path /api*
  handle @api {
    reverse_proxy backend:3000
  }

  handle {
    reverse_proxy frontend:80
  }

  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    Referrer-Policy "strict-origin-when-cross-origin"
    X-Content-Type-Options "nosniff"
    X-Frame-Options "SAMEORIGIN"
  }
}

# ВРЕМЕННО для диагностики по IP (потом удали)
:80 {
  respond "ok 80" 200
}
:443 {
  tls internal
  respond "ok 443" 200
}
